# RHM Extractor – HTTPS with your own / company certificate
<VirtualHost *:80>
    __SERVER_NAME_LINE__
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    __SERVER_NAME_LINE__
    SSLEngine on
    SSLCertificateFile    __SSL_CERT__
    SSLCertificateKeyFile __SSL_KEY__
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder off
    Include __COMMON__
    ErrorLog ${APACHE_LOG_DIR}/rhm_error.log
    CustomLog ${APACHE_LOG_DIR}/rhm_access.log combined
</VirtualHost>
