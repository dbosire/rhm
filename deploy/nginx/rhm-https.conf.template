# /etc/nginx/sites-available/rhm  (HTTPS with your own / company certificate)
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __SERVER_NAME__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:rhm_ssl:10m;
    ssl_session_timeout 1d;
    # HSTS is sent by Django (SECURE_HSTS_SECONDS)

    include snippets/rhm-locations.conf;
}
