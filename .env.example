# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rhm.example.org

# Database: sqlite = quick local trial on this PC; production uses mysql (deploy/install.sh writes /etc/rhm/rhm.env)
DB_ENGINE=sqlite
DB_NAME=rhm_extractor
DB_USER=rhm
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Your existing script – its parse_mpesa_message() is reused (GUI is NOT started)
MPESAV3_SCRIPT_PATH=C:\Users\Administrator\Desktop\Python script\mpesav3.py

# Seeds the (hashed) Excel download password on first run if none is set.
# Admins can change it later under Settings. Remove after first run.
# INITIAL_DOWNLOAD_PASSWORD=

DOWNLOAD_MAX_ATTEMPTS=5
DOWNLOAD_LOCKOUT_SECONDS=900
MAX_UPLOAD_MB=5
MAX_MESSAGES_PER_BATCH=2000

# Email for password reset (console backend prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=RHM Extractor <no-reply@example.org>

# Data retention (days, 0 = keep forever) – applied by: manage.py purge_old_data
RETENTION_DAYS_TRANSACTIONS=0
RETENTION_DAYS_REPORTS=365
RETENTION_DAYS_AUDIT=730

# Optional storage locations
# PRIVATE_MEDIA_ROOT=D:\rhm\private_media
# BACKUP_DIR=D:\rhm\backups
